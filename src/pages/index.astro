---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Problema from "../components/Problema.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Tools from "../components/Tools.astro";
import ComoRodar from "../components/ComoRodar.astro";
import Footer from "../components/Footer.astro";

const title = "anvisa-mcp: consulta regulatória da Anvisa para agentes de IA locais";
const description =
  "Servidor MCP open source para consulta regulatória da Anvisa: status de registro de medicamentos e detecção heurística de SaMD com IA, conectável a modelos de linguagem locais. Um projeto IA.med.";
---

<Layout title={title} description={description}>
  <main>
    <Hero />
    <Problema />
    <ComoFunciona />
    <Tools />
    <ComoRodar />
  </main>
  <Footer />
</Layout>
