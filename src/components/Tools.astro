---
import CodeBlock from "./CodeBlock.astro";

const consultarSig = `consultar_status_medicamento(termo: str) -> dict`;

const consultarRetorno = `{
  "termo": "dipirona monoidratada",
  "resultados": [
    {
      "produto": "DIPIRONA MONOIDRATADA",
      "registro": "1.2345.6789",
      "situacao": "válido",
      "vencimento": "2028-05-31",
      "empresa": "Laboratório Exemplo S.A."
    }
  ],
  "fonte": "Anvisa, consulta pública"
}`;

const samdSig = `buscar_samd_recentes(dias: int = 30, com_ia: bool = True) -> list[dict]`;

const samdRetorno = `[
  {
    "produto": "Sistema de apoio a diagnóstico por imagem",
    "registro": "8.0000.1111",
    "publicado_em": "2026-09-02",
    "ia_provavel": true,
    "confianca": "média",
    "observacao": "classificação heurística, confirmar no registro"
  }
]`;
---

<section id="tools" class="border-b border-neutral-900">
  <div class="mx-auto max-w-4xl px-6 py-20">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald">
      As ferramentas
    </p>
    <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">
      Duas tools MCP expostas ao modelo
    </h2>
    <p class="mt-3 max-w-2xl text-neutral-400">
      O modelo chama estas funções durante a conversa. Os retornos abaixo são
      exemplos do formato; o esquema final segue a implementação do projeto.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <!-- Tool 1 -->
      <article class="flex flex-col gap-4 rounded-xl border border-neutral-800 bg-ink-800 p-5">
        <div>
          <h3 class="font-mono text-base font-semibold text-emerald">
            consultar_status_medicamento
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">
            Consulta a situação de registro de um medicamento por nome ou número
            de registro: se está válido, a validade e a empresa detentora.
          </p>
        </div>
        <CodeBlock code={consultarSig} lang="python" />
        <CodeBlock code={consultarRetorno} lang="json" caption="Exemplo de retorno" />
      </article>

      <!-- Tool 2 -->
      <article class="flex flex-col gap-4 rounded-xl border border-neutral-800 bg-ink-800 p-5">
        <div>
          <h3 class="font-mono text-base font-semibold text-emerald">
            buscar_samd_recentes
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">
            Lista dispositivos (SaMD) publicados num período recente, sinalizando
            os que provavelmente usam IA segundo a classificação heurística.
          </p>
        </div>
        <CodeBlock code={samdSig} lang="python" />
        <CodeBlock code={samdRetorno} lang="json" caption="Exemplo de retorno" />
      </article>
    </div>
  </div>
</section>
